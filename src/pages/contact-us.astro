---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const title = "Contact Us — AI Tokens Cost Calculator";
const description = "Get in touch with the team behind AI Tokens Cost Calculator — report a pricing error, ask a question, or send feedback.";
const contactEmail = "levelupeveryday.official@gmail.com";
---

<Layout title={title} description={description}>
	<Header />

	<section class="mx-auto max-w-3xl px-4 pb-4 pt-12">
		<h1 class="font-sans text-[32px] font-semibold leading-10 tracking-[-1.28px] text-ink sm:text-[48px] sm:leading-[48px] sm:tracking-[-2.4px]">
			Contact Us
		</h1>

		<div class="mt-8 space-y-8">
			<div>
				<p class="font-sans text-[15px] leading-7 text-body">
					Have a question, spotted a pricing error, or want to suggest a model we should add? We'd like
					to hear from you.
				</p>
			</div>

			<div class="rounded-md border border-hairline bg-canvas-soft p-6">
				<h2 class="font-sans text-[15px] font-medium leading-6 text-ink">Email</h2>
				<p class="mt-2 font-sans text-[15px] leading-7 text-body">
					<a href={`mailto:${contactEmail}`} class="text-link underline hover:text-link-deep">{contactEmail}</a>
				</p>
			</div>

			<div>
				<h2 class="font-sans text-[20px] font-semibold leading-7 tracking-[-0.6px] text-ink">What to include</h2>
				<p class="mt-3 font-sans text-[15px] leading-7 text-body">
					If you're reporting incorrect pricing, please include the provider, model name, and a link to
					the official pricing page — that helps us verify and fix it quickly. We aim to respond to
					every message, though response times may vary.
				</p>
			</div>
		</div>
	</section>

	<Footer />
</Layout>
