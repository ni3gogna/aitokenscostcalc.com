---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const title = "Something Went Wrong — AI Tokens Cost Calculator";
const description = "An unexpected error occurred. Please try again.";
---

<Layout title={title} description={description}>
	<Header />

	<section class="mx-auto flex max-w-3xl flex-col items-center px-4 pb-4 pt-20 text-center sm:pt-28">
		<p class="font-mono text-[13px] font-medium text-mute">500</p>
		<h1 class="mt-3 font-sans text-[32px] font-semibold leading-10 tracking-[-1.28px] text-ink sm:text-[48px] sm:leading-[48px] sm:tracking-[-2.4px]">
			Something went wrong
		</h1>
		<p class="mt-4 max-w-md font-sans text-[15px] leading-7 text-body">
			An unexpected error occurred on our end. Please try again, or head back to the calculator.
		</p>
		<a
			href="/"
			class="mt-8 inline-flex h-10 items-center justify-center rounded-md bg-primary px-5 font-sans text-[14px] font-medium text-on-primary transition-colors hover:opacity-90"
		>
			Back to Calculator
		</a>
	</section>

	<Footer />
</Layout>
